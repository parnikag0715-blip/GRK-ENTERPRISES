PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Set to true to append validated enquiries to server/data/enquiries.jsonl
# (note: many hosts have ephemeral disks - use a database or email for production)
STORE_ENQUIRIES=false
# Optional email provider settings (only used if you add the nodemailer step from README)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
